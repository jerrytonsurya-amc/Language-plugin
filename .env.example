# Copy this file to .env and fill in your values. Never commit .env.

# Firebase project used by `npm run deploy` and `npm run serve`
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase web app config (Firebase console > Project settings > Your apps).
# Not read by the current code: the snippet never talks to Firebase directly,
# and the Cloud Function gets its Firebase credentials automatically.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Local dev server (`npm run dev`)
PORT=3456
